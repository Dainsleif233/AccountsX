{
  "schemaVersion": 1,
  "id": "accountsx",
  "version": "${version}",
  "name": "Accounts X",
  "description": "Switch accounts in Minecraft.",
  "authors": [
    "IAFEnvoy",
    "Burning_TNT",
    "JianMoOvO",
    "Dainsleif"
  ],
  "license": "GPL-3.0",
  "icon": "assets/accountsx/textures/gui/sprites/icon/account.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "top.syshub.accountsx.common.AccountsX"
    ]
  },
  "depends": {
    "minecraft": ">=1.20",
    "accountsx-adapter-mc": "*",
    "accountsx-adapter-authlib": "*"
  },
  "custom": {
    "accountsx:impl-lookup-accessor": [
      "top.syshub.accountsx.common.utils.access.UnsafeLookupAccessor",
      "top.syshub.accountsx.common.utils.access.FFMAPILookupAccessor"
    ]
  }
}
